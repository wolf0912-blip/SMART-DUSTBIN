/*
  ESP32 Smart Dustbin - Wet / Dry Waste Segregator + Web Dashboard
  -----------------------------------------------------------------
  NO extra libraries needed. WiFi, WebServer and Preferences are built
  into the ESP32 board package. Servo is driven with the ESP32's own PWM.
  Works with ESP32 Arduino core 2.x and 3.x.

  WIRING
    HC-SR04  VCC  -> 5V (VIN)
             GND  -> GND
             TRIG -> GPIO 5
             ECHO -> GPIO 18  (use voltage divider: ECHO -> 1k -> GPIO18 -> 2k -> GND)
    Servo    VCC  -> 5V (external supply recommended, common GND with ESP32)
             GND  -> GND
             SIG  -> GPIO 13
    Soil     VCC  -> 3.3V
    sensor   GND  -> GND
             AO   -> GPIO 34

  HOW TO VIEW THE WEBSITE
    Default (AP mode):
      1. Power the ESP32.
      2. On your phone/laptop connect to WiFi "SmartDustbin" (password 12345678).
      3. Open browser: http://192.168.4.1
    Home WiFi mode:
      Set USE_HOME_WIFI = true and enter your WiFi name/password below.
      The IP address is printed in Serial Monitor (115200 baud).
*/

#include <WiFi.h>
#include <WebServer.h>
#include <Preferences.h>

// ================= Pins =================
#define TRIG_PIN   5
#define ECHO_PIN   18
#define SERVO_PIN  13
#define SOIL_PIN   34

// ================= WiFi settings =================
const bool  USE_HOME_WIFI = false;          // false = ESP32 makes its own WiFi
const char* HOME_SSID     = "P4x";
const char* HOME_PASS     = "456789ten";
const char* AP_SSID       = "SmartDustbin";
const char* AP_PASS       = "12345678";     // minimum 8 characters

// ================= Servo angles (adjust for your mechanism) =================
#define ANGLE_CENTER 90
#define ANGLE_DRY    20      // tray tilts to DRY bin
#define ANGLE_WET    160     // tray tilts to WET bin

// ================= Tuning =================
#define DETECT_CM      12     // object closer than this = waste on tray
#define SETTLE_MS      1500   // wait for waste to settle on soil probe
#define TILT_HOLD_MS   2000   // how long tray stays tilted
#define COOLDOWN_MS    1000
#define SOIL_SAMPLES   20

// Soil calibration (ESP32 ADC range 0-4095).
// Most modules read HIGH when dry and LOWER when wet.
// Watch the "Soil" value on the website / Serial Monitor and adjust.
#define SOIL_DRY_VALUE  3500
#define SOIL_WET_VALUE  1500
#define SOIL_THRESHOLD  ((SOIL_DRY_VALUE + SOIL_WET_VALUE) / 2)   // below = WET

// ================= Servo PWM (no library) =================
#define SERVO_FREQ 50
#define SERVO_RES  16
#define SERVO_CH   0

void servoAttach() {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(SERVO_PIN, SERVO_FREQ, SERVO_RES);
#else
  ledcSetup(SERVO_CH, SERVO_FREQ, SERVO_RES);
  ledcAttachPin(SERVO_PIN, SERVO_CH);
#endif
}

void servoWrite(int angle) {
  angle = constrain(angle, 0, 180);
  int pulseUs = map(angle, 0, 180, 500, 2400);
  uint32_t duty = (uint32_t)((pulseUs / 20000.0) * 65535.0);
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(SERVO_PIN, duty);
#else
  ledcWrite(SERVO_CH, duty);
#endif
}

// ================= Globals =================
WebServer   server(80);
Preferences prefs;

unsigned long wetCount = 0;
unsigned long dryCount = 0;
String lastItem = "None yet";
int    lastSoil = 0;

enum State { IDLE, SETTLING, TILTED, COOLDOWN };
State state = IDLE;
unsigned long stateStart = 0;
unsigned long lastPoll   = 0;

// ================= Web page =================
const char PAGE[] PROGMEM = R"rawliteral(
