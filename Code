// ================= Web handlers =================
const char* stateName() {
  switch (state) {
    case IDLE:     return "Ready";
    case SETTLING: return "Waste detected...";
    case TILTED:   return "Sorting";
    case COOLDOWN: return "Clearing tray";
  }
  return "-";
}

void handleRoot() {
  server.send_P(200, "text/html", PAGE);
}

void handleData() {
  String json = "{";
  json += "\"wet\":"      + String(wetCount) + ",";
  json += "\"dry\":"      + String(dryCount) + ",";
  json += "\"last\":\""   + lastItem + "\",";
  json += "\"lastSoil\":" + String(lastSoil) + ",";
  json += "\"soil\":"     + String(analogRead(SOIL_PIN)) + ",";
  json += "\"state\":\""  + String(stateName()) + "\"";
  json += "}";
  server.send(200, "application/json", json);
}

void handleReset() {
  wetCount = 0;
  dryCount = 0;
  lastItem = "None yet";
  lastSoil = 0;
  prefs.putULong("wet", 0);
  prefs.putULong("dry", 0);
  server.send(200, "text/plain", "OK");
}

// ================= Sensors =================
float readDistanceCm() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);   // 30 ms timeout
  if (duration == 0) return 999;                    // no echo
  return duration * 0.0343 / 2.0;
}

bool objectPresent() {
  for (int i = 0; i < 3; i++) {                     // 3 readings to avoid false triggers
    if (readDistanceCm() > DETECT_CM) return false;
    delay(30);
  }
  return true;
}

int readSoilAverage() {
  long sum = 0;
  for (int i = 0; i < SOIL_SAMPLES; i++) {
    sum += analogRead(SOIL_PIN);
    delay(5);
  }
  return sum / SOIL_SAMPLES;
}

// ================= Setup =================
void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  analogReadResolution(12);

  servoAttach();
  servoWrite(ANGLE_CENTER);

  prefs.begin("dustbin", false);
  wetCount = prefs.getULong("wet", 0);
  dryCount = prefs.getULong("dry", 0);

  if (USE_HOME_WIFI) {
    WiFi.mode(WIFI_STA);
    WiFi.begin(HOME_SSID, HOME_PASS);
    Serial.print("Connecting to WiFi");
    unsigned long t = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t < 15000) {
      delay(500);
      Serial.print(".");
    }
    if (WiFi.status() == WL_CONNECTED) {
      Serial.println();
      Serial.print("Open in browser: http://");
      Serial.println(WiFi.localIP());
    } else {
      Serial.println("\nWiFi failed, starting own hotspot instead.");
      WiFi.mode(WIFI_AP);
      WiFi.softAP(AP_SSID, AP_PASS);
      Serial.print("Open in browser: http://");
      Serial.println(WiFi.softAPIP());
    }
  } else {
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID, AP_PASS);
    Serial.print("Connect to WiFi '");
    Serial.print(AP_SSID);
    Serial.print("' then open: http://");
    Serial.println(WiFi.softAPIP());
  }

  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.on("/reset", handleReset);
  server.begin();

  Serial.print("Soil threshold (below = WET): ");
  Serial.println(SOIL_THRESHOLD);
  Serial.println("Smart Dustbin ready.");
}

// ================= Loop =================
void loop() {
  server.handleClient();     // keeps website responsive

  unsigned long now = millis();

  switch (state) {

    case IDLE:
      if (now - lastPoll >= 200) {
        lastPoll = now;
        if (objectPresent()) {
          Serial.println("Waste detected, waiting to settle...");
          state = SETTLING;
          stateStart = now;
        }
      }
      break;

    case SETTLING:
      if (now - stateStart >= SETTLE_MS) {
        if (!objectPresent()) {          // false trigger, waste removed
          state = IDLE;
          break;
        }
        lastSoil = readSoilAverage();
        Serial.print("Soil reading: ");
        Serial.println(lastSoil);

        if (lastSoil < SOIL_THRESHOLD) {
          Serial.println("-> WET waste");
          wetCount++;
          lastItem = "Wet";
          prefs.putULong("wet", wetCount);
          servoWrite(ANGLE_WET);
        } else {
          Serial.println("-> DRY waste");
          dryCount++;
          lastItem = "Dry";
          prefs.putULong("dry", dryCount);
          servoWrite(ANGLE_DRY);
        }
        state = TILTED;
        stateStart = millis();
      }
      break;

    case TILTED:
      if (now - stateStart >= TILT_HOLD_MS) {
        servoWrite(ANGLE_CENTER);
        state = COOLDOWN;
        stateStart = now;
      }
      break;

    case COOLDOWN:
      if (now - stateStart >= COOLDOWN_MS && now - lastPoll >= 200) {
        lastPoll = now;
        if (!objectPresent()) {          // wait until tray is clear
          state = IDLE;
        }
      }
      break;
  }
}
